{
    "schemaVersion": 1,
    "id": "roscraft-turtlebot",
    "version": "${version}",
    "name": "Roscraft Turtlebot",
    "description": "Roscraft addon that spawns Minecraft turtles and drives them from turtlebot ROS topics.",
    "authors": [],
    "license": "MIT",
    "environment": "*",
    "entrypoints": {
        "roscraft:addon": [
            "net.roscraft.mod.addon.turtlebot.TurtlebotAddon"
        ]
    },
    "depends": {
        "fabricloader": ">=0.15.0",
        "minecraft": ">=1.21",
        "roscraft": ">=0.1.0"
    }
}
