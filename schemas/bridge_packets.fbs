include "bridge_packets/common.fbs";
include "bridge_packets/graph.fbs";
include "bridge_packets/node.fbs";
include "bridge_packets/topic.fbs";
include "bridge_packets/service.fbs";
include "bridge_packets/interface.fbs";
include "bridge_packets/param.fbs";
include "bridge_packets/action.fbs";
include "bridge_packets/player.fbs";
include "bridge_packets/error.fbs";

namespace roscraft.bridge.fbs;

// ---------------------------------------------------------------------------
// Union and root table
// ---------------------------------------------------------------------------

/// All packet types in a single union so one datagram carries exactly one
/// command. The generated C++ switch over PacketPayload::NONE,
/// PacketPayload::QueryGraphPacket, etc. is exhaustive.
union PacketPayload {
  // Incoming
  QueryGraphPacket,
  NodeInfoPacket,
  TopicInfoPacket,
  ServiceInfoPacket,
  InterfaceListPacket,
  InterfaceShowPacket,
  TopicSubscribePacket,
  TopicPublishMessagePacket,
  QueryPlayersPacket,
  TopicHzPacket,
  TopicBwPacket,
  ServiceCallPacket,
  ParamListPacket,
  ParamGetPacket,
  ParamSetPacket,
  ParamDescribePacket,
  ParamDumpPacket,
  ActionInfoPacket,
  ActionSendGoalPacket,
  TopicDelayPacket,
  ParamLoadPacket,
  // Outgoing
  GraphSnapshotPacket,
  NodeInfoResponsePacket,
  TopicInfoResponsePacket,
  ServiceInfoResponsePacket,
  InterfaceListResponsePacket,
  InterfaceShowResponsePacket,
  TopicPayloadPacket,
  TopicHzResponsePacket,
  TopicBwResponsePacket,
  ServiceCallResponsePacket,
  ParamListResponsePacket,
  ParamGetResponsePacket,
  ParamSetResponsePacket,
  ParamDescribeResponsePacket,
  ParamDumpResponsePacket,
  ActionInfoResponsePacket,
  ActionFeedbackPacket,
  ActionResultPacket,
  PlayerListPacket,
  ErrorPacket,
  TopicDelayResponsePacket,
  ParamLoadResponsePacket,
}

/// Root table — every datagram deserializes to this.
table BridgePacket {
  payload:PacketPayload (required);
}

root_type BridgePacket;

// File identifier embedded in the buffer (optional but useful for debugging).
file_identifier "RCFT";
file_extension  "bin";
