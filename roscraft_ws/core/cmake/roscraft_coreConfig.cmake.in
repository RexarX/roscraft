@PACKAGE_INIT@

# Ensure roscraft::flat_map target exists before loading export targets.
# This target is created by the roscraft FlatMap dependency system at build time,
# but needs to be recreated for installed package consumers.
if(NOT TARGET roscraft::flat_map)
  if(@roscraft_USE_STL_FLAT_MAP@)
    add_library(roscraft::flat_map INTERFACE IMPORTED GLOBAL)
    target_compile_definitions(roscraft::flat_map INTERFACE roscraft_USE_STL_FLAT_MAP)
  else()
    find_package(Boost QUIET)
    if(TARGET Boost::container)
      add_library(roscraft::flat_map INTERFACE IMPORTED GLOBAL)
      target_link_libraries(roscraft::flat_map INTERFACE Boost::container)
    elseif(TARGET Boost::boost)
      add_library(roscraft::flat_map INTERFACE IMPORTED GLOBAL)
      target_link_libraries(roscraft::flat_map INTERFACE Boost::boost)
      if(Boost_SOURCE_DIR AND EXISTS "${Boost_SOURCE_DIR}/libs/container/include")
        target_include_directories(roscraft::flat_map SYSTEM INTERFACE
            "${Boost_SOURCE_DIR}/libs/container/include"
        )
      endif()
    else()
      message(WARNING "roscraft_core: Could not create roscraft::flat_map - "
          "Neither C++23 std::flat_map nor Boost.Container are available. "
          "Install Boost (libboost-container-dev) or use a compiler supporting C++23 std::flat_map.")
    endif()
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/roscraft_coreTargets.cmake")

check_required_components(roscraft_core)