@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(roscraft_core REQUIRED)

find_dependency(ament_index_cpp REQUIRED)
find_dependency(rclcpp REQUIRED)
find_dependency(rclcpp_action REQUIRED)
find_dependency(action_msgs REQUIRED)
find_dependency(builtin_interfaces REQUIRED)
find_dependency(geometry_msgs REQUIRED)
find_dependency(std_srvs REQUIRED)
find_dependency(std_msgs REQUIRED)

find_dependency(concurrentqueue REQUIRED)

find_package(flatbuffers QUIET CONFIG)
if(NOT flatbuffers_FOUND)
  find_package(FlatBuffers QUIET CONFIG)
endif()

if(NOT TARGET roscraft::flatbuffers)
  if(TARGET flatbuffers::flatbuffers)
    add_library(roscraft::flatbuffers INTERFACE IMPORTED GLOBAL)
    set_property(TARGET roscraft::flatbuffers PROPERTY
        INTERFACE_LINK_LIBRARIES flatbuffers::flatbuffers)
  elseif(TARGET flatbuffers::flatbuffers_shared)
    add_library(roscraft::flatbuffers INTERFACE IMPORTED GLOBAL)
    set_property(TARGET roscraft::flatbuffers PROPERTY
        INTERFACE_LINK_LIBRARIES flatbuffers::flatbuffers_shared)
  elseif(TARGET flatbuffers::libflatbuffers)
    add_library(roscraft::flatbuffers INTERFACE IMPORTED GLOBAL)
    set_property(TARGET roscraft::flatbuffers PROPERTY
        INTERFACE_LINK_LIBRARIES flatbuffers::libflatbuffers)
  elseif(TARGET FlatBuffers::FlatBuffers)
    add_library(roscraft::flatbuffers INTERFACE IMPORTED GLOBAL)
    set_property(TARGET roscraft::flatbuffers PROPERTY
        INTERFACE_LINK_LIBRARIES FlatBuffers::FlatBuffers)
  elseif(TARGET flatbuffers)
    add_library(roscraft::flatbuffers INTERFACE IMPORTED GLOBAL)
    set_property(TARGET roscraft::flatbuffers PROPERTY
        INTERFACE_LINK_LIBRARIES flatbuffers)
  else()
    find_path(_roscraft_flatbuffers_include_dir
        NAMES flatbuffers/flatbuffers.h
    )
    if(_roscraft_flatbuffers_include_dir)
      add_library(roscraft::flatbuffers INTERFACE IMPORTED GLOBAL)
      set_property(TARGET roscraft::flatbuffers PROPERTY
          INTERFACE_INCLUDE_DIRECTORIES "${_roscraft_flatbuffers_include_dir}")
    endif()
  endif()
endif()

if(NOT TARGET roscraft::flatbuffers)
  message(FATAL_ERROR
      "roscraft_bridge_common requires FlatBuffers headers, but no compatible "
      "flatbuffers target or include directory was found."
  )
endif()

# Ensure roscraft::flat_map target exists before loading export targets.
# This target is created by the roscraft FlatMap dependency system at build time,
# but needs to be recreated for installed package consumers.
if(NOT TARGET roscraft::flat_map)
  if(@roscraft_USE_STL_FLAT_MAP@)
    add_library(roscraft::flat_map INTERFACE IMPORTED GLOBAL)
    target_compile_definitions(roscraft::flat_map INTERFACE roscraft_USE_STL_FLAT_MAP)
  else()
    find_dependency(Boost QUIET)
    if(TARGET Boost::container)
      add_library(roscraft::flat_map INTERFACE IMPORTED GLOBAL)
      target_link_libraries(roscraft::flat_map INTERFACE Boost::container)
    elseif(TARGET Boost::boost)
      add_library(roscraft::flat_map INTERFACE IMPORTED GLOBAL)
      target_link_libraries(roscraft::flat_map INTERFACE Boost::boost)
      if(Boost_SOURCE_DIR AND EXISTS "${Boost_SOURCE_DIR}/libs/container/include")
        target_include_directories(roscraft::flat_map SYSTEM INTERFACE
            "${Boost_SOURCE_DIR}/libs/container/include"
        )
      endif()
    else()
      message(WARNING "roscraft_bridge_common: Could not create roscraft::flat_map - "
          "Neither C++23 std::flat_map nor Boost.Container are available.")
    endif()
  endif()
endif()

# Include rosidl exports before the library target (it references them).
set(_share_cmake "${CMAKE_CURRENT_LIST_DIR}/../../../share/roscraft_bridge_common/cmake")
foreach(_suffix
    rosidl_generator_c
    rosidl_typesupport_fastrtps_c
    rosidl_generator_cpp
    rosidl_typesupport_fastrtps_cpp
    rosidl_typesupport_introspection_c
    rosidl_typesupport_c
    rosidl_typesupport_introspection_cpp
    rosidl_typesupport_cpp
    rosidl_generator_py)
  set(_export "${_share_cmake}/export_roscraft_bridge_common__${_suffix}Export.cmake")
  if(NOT EXISTS "${_export}")
    set(_export "${_share_cmake}/roscraft_bridge_common__${_suffix}Export.cmake")
  endif()
  if(EXISTS "${_export}")
    include("${_export}")
  endif()
endforeach()

include("${CMAKE_CURRENT_LIST_DIR}/roscraft_bridge_commonTargets.cmake")

check_required_components(roscraft_bridge_common)
